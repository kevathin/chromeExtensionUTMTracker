{
    "name": "UTM Tracking Debugger",
    "version": "1.0",
    "description": "A Chrome extension to debug UTM tracking parameters in URLs",
    "manifest_version": 3,
    "permissions": [
        "activeTab",
        "scripting",
        "cookies",
        "webRequest"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["background.js"],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    }

}