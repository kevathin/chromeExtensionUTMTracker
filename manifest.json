{
    "name": "UTM Tracking Debugger",
    "version": "1.0",
    "description": "A Chrome extension to debug UTM tracking parameters in URLs",
    "manifest_version": 3,
    "background": {
        "service_worker": "background.js"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "cookies",
        "webRequest"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "index.html",
        "default_icon": "icon.png"
    }

}